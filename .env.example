# redBook runtime configuration.
# Copy to .env.local for development. Never commit real values.

# Public origin of this app. MUST be the real https origin in production:
# accounts.redbtn.io only accepts an https, first-party *.redbtn.io return URL.
PUBLIC_URL=http://127.0.0.1:3000

# Central sign-in host that owns the shared session.
ACCOUNTS_URL=https://accounts.redbtn.io

# Application database. DB names are case-sensitive. URL-encode any special
# characters in the password (+ -> %2B, / -> %2F, = -> %3D).
MONGODB_URI=mongodb://127.0.0.1:27017/redbook
MONGODB_DB=redbook

# The SHARED ecosystem secret that accounts.redbtn.io signs red_session with.
# redBook only ever VERIFIES with it. Do not wrap the value in quotes.
JWT_SECRET=

# Optional: enables the X-User-Id + X-Internal-Key service transport.
INTERNAL_SERVICE_KEY=

# Optional: resolve JWT_SECRET from the encrypted redsecrets store instead.
# REDBOOK_SECRETS_ENCRYPTION_KEY=
# REDSECRETS_DATABASE=redshared

# The shared org bootstrapped on first use, and the humans seated in it.
# An email with no ecosystem identity yet becomes a PENDING member and is
# claimed automatically the first time that person signs in — which is how the
# Josh placeholder stays easy to update (change this line, or edit the one row
# in the org_pending_members collection).
# REDBOOK_DEFAULT_ORG_NAME=FinThrive
# REDBOOK_DEFAULT_ORG_SLUG=finthrive
# REDBOOK_ORG_MEMBER_EMAILS=george8794@gmail.com,josh@finthrive.example

# Shared redauth directory, read-only, for the email -> userId lookup above.
# Defaults to MONGODB_URI's host with the `redauth` database.
# AUTH_MONGODB_URI=
# AUTH_MONGODB_DB=redauth

# Set to "false" to stop seeding a new org's empty book with starter data.
# REDBOOK_AUTOSEED=true

# Optional: credentials for the legacy public POST /send lead-email endpoint.
# EMAIL_USER=
# EMAIL_PASS=
